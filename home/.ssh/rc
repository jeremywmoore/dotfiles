# sshd runs this before every session. It points ~/.ssh/agent.sock at a
# forwarded agent that answers, so long-lived shells (Rex terminals, which
# don't run under sshd) keep a working SSH_AUTH_SOCK.
#
# ssh-add -l exits 0 (keys) or 1 (no keys) when the agent answers and 2 when
# it can't connect. A socket left by an SSH session whose client is gone still
# accepts connections but never answers, so bound the check: without the
# timeout, every new SSH connection hangs here.
if [ -S "$SSH_AUTH_SOCK" ] && [ "$SSH_AUTH_SOCK" != "$HOME/.ssh/agent.sock" ]; then
	SSH_AUTH_SOCK="$HOME/.ssh/agent.sock" timeout 2 ssh-add -l >/dev/null 2>&1
	case $? in
	2 | 124) ln -sf "$SSH_AUTH_SOCK" "$HOME/.ssh/agent.sock" ;;
	esac
fi
